
# ERPNext
ERP_URL=http://localhost:8080

# Prefer dedicated integration-user credentials
ERP_USER=your_integration_user
ERP_PASSWORD=your_password

# Or Token authentication 
ERP_API_KEY=your_api_key
ERP_API_SECRET=your_api_secret


# LLM - Groq
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key

# LLAMA.CPP - Local inference
#LLAMACPP_BASE_URL=http://127.0.0.1:8081/v1
#LLM_PROVIDER=llamacpp
#LLM_MODEL=qwen/qwen2.5-3b

# Embeddings - Ollama
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text


# LangSmith - Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=industrial-ai-agent
